# 複製成 .env.local：  cp .env.local.example .env.local
# 這些值都會在 build 時內嵌進瀏覽器端程式碼，不要放任何機密。
NEXT_PUBLIC_API_BASE=http://localhost:8080
# Demo 用萬用 token，後端刻意接受；正式環境改由登入流程取得 Apigee 簽發的 JWT
NEXT_PUBLIC_API_TOKEN=MOCK_APIGEE_TOKEN
# 前端唯讀查鏈（公開節點，免金鑰）與已部署的存證合約
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CONTRACT_ADDRESS=0xAf8CA554c540526452B0B53bE7e203A5754363ac
